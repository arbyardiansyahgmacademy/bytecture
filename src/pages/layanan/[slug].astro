---
import MainLayout from '../../layouts/MainLayout.astro';
import { services, type ServiceItem } from '../../data/services';
import { siteConfig } from '../../data/site';
import FAQ from '../../components/common/FAQ.astro';
import CTASection from '../../components/common/CTASection.astro';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

// Other services for related section
const otherServices = services.filter((s) => s.slug !== service.slug);

const pageTitle = `${service.title} — Jasa Arsitek Online Indonesia`;
const pageDescription = service.shortDescription;
const waContextMessage = `Halo Jasa Arsitek, saya ingin berkonsultasi mengenai ${service.title} untuk proyek saya.`;

// Service Schema
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: 'Architectural Design',
  provider: {
    '@type': 'ProfessionalService',
    name: siteConfig.name,
    url: siteConfig.domain,
  },
  description: service.fullDescription,
  areaServed: {
    '@type': 'Country',
    name: 'Indonesia',
  },
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/layanan/${service.slug}/`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Layanan', url: '/layanan/' },
    { name: service.title },
  ]}
  ogImage={service.image}
>
  <!-- Schema.org Service -->
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- =========================================================================
       HERO SPESIFIK LAYANAN
       ========================================================================= -->
  <section class="section-spacing" style="padding-top: 1.5rem;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center;">
        <div style="max-width: 860px;">
          <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem;">
            {service.badge && (
              <span class="badge-pill badge-accent">
                {service.badge}
              </span>
            )}
            <span class="badge-pill badge-glass" style="color: var(--color-text-secondary);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 4px;">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              {service.estimatedTime}
            </span>
            <span class="badge-pill badge-glass" style="color: var(--color-accent-dark); font-weight: 700;">
              {service.priceRange}
            </span>
          </div>

          <h1 style="margin-bottom: 1rem; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.18;">
            {service.title}
          </h1>
          <p style="font-size: 1.2rem; font-weight: 600; color: var(--color-text-primary); margin-bottom: 1.25rem; line-height: 1.45;">
            {service.subtitle}
          </p>
          <p style="font-size: 1.05rem; line-height: 1.75; color: var(--color-text-secondary); margin-bottom: 2rem;">
            {service.fullDescription}
          </p>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a
              href={`${siteConfig.whatsappUrl}?text=${encodeURIComponent(waContextMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              style="padding: 0.85rem 1.8rem;"
            >
              <span>Konsultasikan via WhatsApp</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="/paket/" target="_self" class="btn btn-secondary" style="padding: 0.85rem 1.6rem;">
              <span>Lihat Pilihan Paket & Tarif</span>
            </a>
          </div>
        </div>

        <div style="border-radius: var(--radius-2xl); overflow: hidden; box-shadow: var(--glass-shadow-lg); border: 1px solid var(--color-border); max-height: 500px;">
          <img
            src={service.image}
            alt={`Visualisasi portofolio arsitektur ${service.title}`}
            width="800"
            height="500"
            style="width: 100%; height: 100%; object-fit: cover;"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       VALUE PROPOSITIONS (KEUNGGULAN UTAMA)
       ========================================================================= -->
  <section class="section-spacing" style="background: var(--color-bg-canvas); padding: 3rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        {service.benefits.map((benefit) => (
          <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.25rem 1.4rem; display: flex; align-items: flex-start; gap: 0.85rem; box-shadow: var(--glass-shadow-sm);">
            <div style="width: 28px; height: 28px; border-radius: 50%; background: rgba(200, 155, 107, 0.15); color: var(--color-accent-dark); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p style="font-size: 0.94rem; color: var(--color-text-primary); line-height: 1.55; font-weight: 500; margin: 0;">
              {benefit}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       ALUR PROSES PENGERJAAN STEP-BY-STEP (WORKFLOW)
       ========================================================================= -->
  <section class="section-spacing">
    <div class="container">
      <div style="max-width: 860px; margin: 0 auto 3rem; text-align: center;">
        <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.5rem;">ALUR KERJA PROFESIONAL</span>
        <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin-bottom: 0.75rem;">
          Tahapan Perancangan Bersama Jasa Arsitek
        </h2>
        <p style="font-size: 1.05rem; color: var(--color-text-secondary); line-height: 1.6;">
          Proses kolaborasi daring yang terstruktur rapi, transparan, dan terukur dari awal data lahan hingga serah terima berkas final siap bangun.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
        {service.workflow.map((wf) => (
          <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.75rem 1.5rem; display: flex; flex-direction: column; position: relative; box-shadow: var(--glass-shadow-sm); transition: transform var(--transition-fast);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <span style="font-size: 1.5rem; font-weight: 800; color: var(--color-accent-dark); font-family: var(--font-family-serif, inherit);">
                {wf.step}
              </span>
              <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-text-muted); background: rgba(20, 21, 23, 0.05); padding: 0.25rem 0.6rem; border-radius: var(--radius-pill);">
                {wf.duration}
              </span>
            </div>
            <h3 style="font-size: 1.12rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.65rem; line-height: 1.35;">
              {wf.title}
            </h3>
            <p style="font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.55; margin: 0;">
              {wf.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       RUANG LINGKUP & DELIVERABLES LENGKAP
       ========================================================================= -->
  <section class="section-spacing" style="background: var(--color-bg-canvas);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem;">
        <!-- Ruang Lingkup Pekerjaan -->
        <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--glass-shadow-sm);">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem;">
            <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--color-primary); color: #ffffff; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M3 9h18"></path>
                <path d="M9 21V9"></path>
              </svg>
            </div>
            <h2 style="font-size: 1.35rem; color: var(--color-text-primary); margin: 0;">
              Ruang Lingkup Pekerjaan
            </h2>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            Cakupan tugas arsitek profesional yang kami kerjakan untuk memastikan setiap aspek bangunan Anda terencana dengan presisi teknis tinggi:
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem;">
            {service.scope.map((item) => (
              <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.94rem; color: var(--color-text-secondary); line-height: 1.6;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-dark)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 3px;">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Hasil / Deliverables yang Diterima Klien -->
        <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--glass-shadow-sm);">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem;">
            <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: #16a34a; color: #ffffff; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <h2 style="font-size: 1.35rem; color: var(--color-text-primary); margin: 0;">
              Dokumen & File Serah Terima
            </h2>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            Seluruh berkas diserahkan dalam format digital master PDF resolusi tinggi (skala A3) yang siap langsung diserahkan kepada mandor atau kontraktor:
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.95rem;">
            {service.deliverables.map((item) => (
              <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.94rem; color: var(--color-text-primary); line-height: 1.55;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" style="flex-shrink: 0; margin-top: 3px;">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SISTEM PEMBAYARAN BERTAHAP 3 TERMIN
       ========================================================================= -->
  <section class="section-spacing">
    <div class="container">
      <div style="background: linear-gradient(135deg, rgba(20, 21, 23, 0.03) 0%, rgba(200, 155, 107, 0.08) 100%); border: 1px solid rgba(200, 155, 107, 0.3); border-radius: var(--radius-2xl); padding: clamp(2rem, 5vw, 3rem); box-shadow: var(--glass-shadow-sm);">
        <div style="max-width: 820px; margin-bottom: 2rem;">
          <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.5rem;">TRANSPARANSI KONTRAK</span>
          <h2 style="font-size: clamp(1.6rem, 3.2vw, 2.1rem); margin-bottom: 0.75rem;">
            Skema Pembayaran Termin Bertahap yang Aman
          </h2>
          <p style="font-size: 1rem; color: var(--color-text-secondary); line-height: 1.65;">
            Kami menerapkan sistem termin 3 tahap berjenjang berdasarkan progress output nyata. Anda hanya membayar termin lanjutan ketika tahap sebelumnya telah disepakati bersama.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
          {service.paymentStages.map((stage, idx) => (
            <div style="background: #ffffff; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; box-shadow: 0 4px 14px rgba(0,0,0,0.03);">
              <span style="font-size: 0.8rem; font-weight: 800; color: var(--color-accent-dark); text-transform: uppercase; letter-spacing: 0.08em;">
                Tahap {idx + 1}
              </span>
              <p style="font-size: 0.94rem; color: var(--color-text-primary); line-height: 1.55; margin: 0; font-weight: 500;">
                {stage}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       HAL YANG PERLU DISIAPKAN KLIEN
       ========================================================================= -->
  <section class="section-spacing" style="background: var(--color-bg-canvas);">
    <div class="container">
      <div style="max-width: 840px; margin: 0 auto; background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(2rem, 5vw, 3rem); box-shadow: var(--glass-shadow-sm);">
        <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.75rem;">CHECKLIST KONSULTASI</span>
        <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 1rem;">Data yang Perlu Anda Siapkan</h2>
        <p style="font-size: 1rem; color: var(--color-text-secondary); margin-bottom: 2rem; line-height: 1.65;">
          Agar sesi konsultasi online via WhatsApp dapat langsung mengerucut pada solusi konkret, siapkan beberapa data sederhana berikut:
        </p>

        <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem;">
          {service.clientPreparation.map((prep, i) => (
            <li style="display: flex; align-items: flex-start; gap: 1rem; font-size: 0.96rem; color: var(--color-text-primary); line-height: 1.55;">
              <span style="display: inline-flex; width: 28px; height: 28px; border-radius: 50%; background: var(--color-primary); color: #ffffff; font-weight: 700; font-size: 0.82rem; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
                {i + 1}
              </span>
              <span>{prep}</span>
            </li>
          ))}
        </ul>

        <div style="margin-top: 2.25rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border-light); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <span style="font-size: 0.92rem; color: var(--color-text-muted);">Belum memiliki ukuran pasti? Konsultasikan dulu bersama tim kami.</span>
          <a
            href={`${siteConfig.whatsappUrl}?text=${encodeURIComponent(waContextMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
            style="padding: 0.65rem 1.4rem; font-size: 0.88rem;"
          >
            <span>Tanya Arsitek via WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       FAQ SPESIFIK LAYANAN
       ========================================================================= -->
  {service.faqs && service.faqs.length > 0 && (
    <FAQ
      items={service.faqs}
      title={`Tanya Jawab Seputar ${service.title}`}
      eyebrow="INFORMASI DETAIL & TEKNIS"
    />
  )}

  <!-- =========================================================================
       LAYANAN TERKAIT LAINNYA
       ========================================================================= -->
  <section class="section-spacing" style="background: var(--color-bg-canvas);">
    <div class="container">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.5rem;">EKSPLORASI ARSITEKTUR</span>
          <h2 style="font-size: 1.6rem; margin: 0;">Layanan Terkait Lainnya</h2>
        </div>
        <a href="/layanan/" target="_self" class="btn btn-secondary" style="font-size: 0.86rem; padding: 0.55rem 1.2rem;">
          <span>Lihat Semua Layanan</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>

      <div class="cards-grid-3">
        {otherServices.slice(0, 3).map((s) => (
          <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--glass-shadow-sm);">
            <div>
              <span class="badge-pill" style="font-size: 0.72rem; padding: 0.2rem 0.6rem; margin-bottom: 0.75rem;">{s.badge}</span>
              <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">{s.title}</h3>
              <p style="font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
                {s.shortDescription}
              </p>
            </div>
            <a href={`/layanan/${s.slug}/`} target="_self" class="btn btn-secondary" style="width: 100%;">
              <span>Pelajari {s.title}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       CTA SECTION
       ========================================================================= -->
  <CTASection
    title={`Siap Memulai Proyek ${service.title}?`}
    description="Kirimkan sketsa ukuran tanah atau rencana kebutuhan ruangan Anda melalui WhatsApp resmi Jasa Arsitek untuk mendapatkan simulasi rancangan awal."
    customMessage={waContextMessage}
  />
</MainLayout>
