        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-media">
        <img id="lightbox-img" src="" alt="Pratinjau detail arsitektur" />
      </div>

      <div class="lightbox-info">
        <div>
          <h4 id="lightbox-title" style="font-size: 1.2rem; color: #ffffff; margin-bottom: 0.25rem;"></h4>
          <p id="lightbox-desc" style="font-size: 0.88rem; color: #9da3af;"></p>
        </div>
        <div id="lightbox-specs" style="font-size: 0.82rem; color: #d1d5db; white-space: nowrap;"></div>
      </div>
    </div>
  </div>

  <script>
    const triggers = document.querySelectorAll('.js-lightbox-trigger');
    const lightbox = document.getElementById('gallery-lightbox');
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lbTitle = document.getElementById('lightbox-title');
    const lbDesc = document.getElementById('lightbox-desc');
    const lbSpecs = document.getElementById('lightbox-specs');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentIndex = 0;
    const itemsData: Array<{ src: string; title: string; desc: string; specs: string; alt: string }> = [];

    triggers.forEach((trigger, idx) => {
      const el = trigger as HTMLElement;
      itemsData.push({
        src: el.dataset.src || '',
        title: el.dataset.title || '',
        desc: el.dataset.desc || '',
        specs: `${el.dataset.area || ''} • ${el.dataset.floors || ''} • ${el.dataset.style || ''}`,
        alt: el.dataset.title || 'Foto galeri arsitektur',
      });

      const openThis = () => {
        currentIndex = idx;
        renderLightbox();
        lightbox?.classList.add('active');
        lightbox?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      trigger.addEventListener('click', openThis);
      trigger.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openThis();
        }
      });
    });

    function renderLightbox() {
      const data = itemsData[currentIndex];
      if (!data) return;
      if (lbImg) {
        lbImg.src = data.src;
        lbImg.alt = data.alt;
      }
      if (lbTitle) lbTitle.textContent = data.title;
      if (lbDesc) lbDesc.textContent = data.desc;
      if (lbSpecs) lbSpecs.textContent = data.specs;
    }

    function closeLightbox() {
      lightbox?.classList.remove('active');
      lightbox?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + itemsData.length) % itemsData.length;
      renderLightbox();
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % itemsData.length;
      renderLightbox();
    }

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    window.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    });

    // =========================================================================
    // Hero Top Pill Dropdown Popovers Controller
    // =========================================================================
    const pillTriggers = document.querySelectorAll<HTMLButtonElement>('.pill-nav-dropdown-trigger');
    const dropdownMenus = document.querySelectorAll<HTMLElement>('.hero-pill-dropdown-menu');

    function closeAllHeroDropdowns() {
      pillTriggers.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
      dropdownMenus.forEach((menu) => menu.classList.remove('is-open'));
    }

    pillTriggers.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('aria-controls');
        const targetMenu = targetId ? document.getElementById(targetId) : null;
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        closeAllHeroDropdowns();

        if (!isExpanded && targetMenu) {
          btn.setAttribute('aria-expanded', 'true');
          targetMenu.classList.add('is-open');
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement)?.closest('.pill-dropdown-wrap')) {
        closeAllHeroDropdowns();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllHeroDropdowns();
      }
    });
  </script>
