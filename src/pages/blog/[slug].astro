              <img src={pkg.image} alt={pkg.title} loading="lazy" width="400" height="240" />
            </div>
            <div class="body">
              <span class="prod-cat-label">{pkg.badge || 'Paket Pilihan'}</span>
              <h4><a href={`/paket/${pkg.slug}/`}>{pkg.title}</a></h4>
              <p>{pkg.shortDescription}</p>
              <div class="rec-price-row">
                <strong>{pkg.priceDisplay}</strong>
              </div>
              <a href={`/paket/${pkg.slug}/`} class="prod-card-link-auto">Lihat Detail Paket &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
