---
import MainLayout from '../layouts/MainLayout.astro';
import { siteConfig } from '../data/site';
import ContactForm from '../components/forms/ContactForm.astro';
import FAQ from '../components/common/FAQ.astro';
import { generalFaqs } from '../data/faqs';

const title = 'Kontak & Konsultasi Jasa Arsitek Online — Bytecture';
const description = 'Hubungi tim arsitek Bytecture untuk konsultasi desain rumah tinggal, renovasi, atau bangunan komersial di seluruh Indonesia melalui WhatsApp 083115542771.';

const socialCards = [
  {
    name: 'WhatsApp Resmi',
    handle: siteConfig.phoneDisplay,
    badge: 'Konsultasi Cepat',
    desc: 'Saluran utama respon cepat untuk konsultasi tata ruang, pengiriman denah kasar, dan hitungan estimasi RAB awal gratis.',
    url: siteConfig.whatsappUrl,
    btnText: 'Chat WhatsApp Arsitek',
    type: 'whatsapp',
  },
  {
    name: 'Instagram Portofolio',
    handle: '@bytecture',
    badge: 'Galeri Fasad 3D',
    desc: 'Galeri visual render 3D fasad modern tropis resolusi tinggi, tata ruang interior, dan dokumentasi pengerjaan proyek.',
    url: siteConfig.socials.instagram,
    btnText: 'Kunjungi Instagram',
    type: 'instagram',
  },
  {
    name: 'TikTok Studio',
    handle: '@bytecture',
    badge: 'Video Tur 3D',
    desc: 'Animasi walkthrough 3D arsitektur, bedah denah rumah efisien budget, dan tips konstruksi praktis ramah iklim tropis.',
    url: siteConfig.socials.tiktok,
    btnText: 'Tonton di TikTok',
    type: 'tiktok',
  },
  {
    name: 'Facebook Page',
    handle: 'Bytecture Architecture',
    badge: 'Komunitas & Info',
    desc: 'Diskusi seputar tips membangun rumah, ulasan gambar kerja, serta panduan memilih material awet dan efisien biaya.',
    url: siteConfig.socials.facebook,
    btnText: 'Buka Halaman Facebook',
    type: 'facebook',
  },
  {
    name: 'YouTube Channel',
    handle: 'Bytecture Official',
    badge: 'Cinematic 4K',
    desc: 'Video presentasi arsitektur 4K fotorealistik, simulasi pencahayaan alami senja tropis, dan studi kasus proyek nyata.',
    url: siteConfig.socials.youtube,
    btnText: 'Subscribe YouTube',
    type: 'youtube',
  },
  {
    name: 'X (Twitter)',
    handle: '@bytecture',
    badge: 'Tren Arsitektur',
    desc: 'Eksplorasi gagasan desain arsitektural modern tropis, tren perancangan hunian sehat, dan inovasi arsitektur digital.',
    url: siteConfig.socials.twitter,
    btnText: 'Ikuti di X (Twitter)',
    type: 'twitter',
  },
];
---

<MainLayout
  title={title}
  description={description}
  canonicalPath="/kontak/"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Kontak' },
  ]}
>
  <!-- Header / Hero Section -->
  <section class="contact-hero-section">
    <div class="container">
      <div class="contact-hero-content">
        <span class="eyebrow eyebrow-accent">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>KONSULTASI & INFORMASI RESMI</span>
        </span>
        <h1 class="contact-hero-title">Mulai Rencana Bangunan Bersama Arsitek Bytecture</h1>
        <p class="contact-hero-desc">
          Konsultasi arsitek online terpercaya dan terstruktur untuk hunian maupun ruang usaha Anda di seluruh pelosok Indonesia. Diskusikan ide, kebutuhan ruang, estimasi biaya, atau kirimkan denah kasar tanah Anda langsung ke tim arsitek kami.
        </p>

        <!-- Trust Signals Bar -->
        <div class="contact-trust-bar">
          <div class="trust-pill">
            <span class="trust-dot-live"></span>
            <span>Respon WhatsApp Kilat (&lt; 15 Menit)</span>
          </div>
          <div class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>100% Konsultasi Digital Seluruh Nusantara</span>
          </div>
          <div class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Jam Layanan 08.00 – 21.00 WIB</span>
          </div>
          <div class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Studio Pusat: Kota Malang, Jawa Timur</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Section: Form & Direct Studio Contacts -->
  <section class="section-spacing" style="padding-top: 0;">
    <div class="container">
      <div class="contact-main-grid">
        <!-- Left: Form Card -->
        <div class="contact-form-card">
          <div class="form-card-header">
            <div class="form-card-title-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="form-header-icon" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <h2>Formulir Konsultasi Proyek</h2>
            </div>
            <p>
              Isi data awal rencana hunian Anda. Tim kami akan mempelajari spesifikasi lahan dan menyusun rekomendasi konsep terbaik.
            </p>
          </div>
          <ContactForm />
        </div>

        <!-- Right: VIP WhatsApp Box & Studio Map Card -->
        <div class="contact-sidebar-cards">
          <!-- Card 1: VIP WhatsApp Hotline -->
          <div class="contact-vip-wa-card">
            <div class="vip-wa-header">
              <div class="vip-wa-badge-row">
                <span class="vip-wa-pill">
                  <span class="live-pulse-dot"></span>
                  <span>ONLINE SEKARANG</span>
                </span>
                <span class="vip-wa-hours">08.00 – 21.00 WIB</span>
              </div>
              <div class="vip-wa-brand-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.13 15.86C14.15 16.73 14.56 16.56 15 16.51C15.44 16.47 16.42 15.93 16.62 15.36C16.82 14.79 16.82 14.3 16.76 14.2C16.7 14.1 16.54 14.04 16.3 13.92C16.06 13.8 14.88 13.22 14.66 13.14C14.44 13.06 14.28 13.02 14.12 13.26C13.96 13.5 13.5 14.1 13.36 14.26C13.22 14.42 13.08 14.44 12.84 14.32C12.6 14.2 11.83 13.95 10.91 13.13C10.2 12.5 9.71 11.71 9.58 11.47C9.44 11.23 9.56 11.1 9.68 10.98C9.79 10.87 9.93 10.69 10.05 10.55C10.17 10.41 10.21 10.31 10.29 10.15C10.37 9.99 10.33 9.85 10.27 9.73C10.21 9.61 9.75 8.47 9.56 7.99C9.37 7.53 9.17 7.59 9.03 7.58C8.89 7.58 8.73 7.58 8.57 7.58L8.53 7.33Z"/>
                </svg>
              </div>
            </div>

            <h3>WhatsApp Hotline Resmi</h3>
            <p class="vip-wa-desc">
              Kirimkan sketsa coretan denah, foto sertifikat tanah, atau video lokasi langsung via WhatsApp untuk respon instan dari arsitek.
            </p>

            <div class="vip-wa-number-box">
              <span class="wa-num-label">Nomor Resmi Terverifikasi:</span>
              <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="wa-num-link">
                {siteConfig.phoneDisplay}
              </a>
            </div>

            <a
              href={siteConfig.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp vip-wa-cta"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.13 15.86C14.15 16.73 14.56 16.56 15 16.51C15.44 16.47 16.42 15.93 16.62 15.36C16.82 14.79 16.82 14.3 16.76 14.2C16.7 14.1 16.54 14.04 16.3 13.92C16.06 13.8 14.88 13.22 14.66 13.14C14.44 13.06 14.28 13.02 14.12 13.26C13.96 13.5 13.5 14.1 13.36 14.26C13.22 14.42 13.08 14.44 12.84 14.32C12.6 14.2 11.83 13.95 10.91 13.13C10.2 12.5 9.71 11.71 9.58 11.47C9.44 11.23 9.56 11.1 9.68 10.98C9.79 10.87 9.93 10.69 10.05 10.55C10.17 10.41 10.21 10.31 10.29 10.15C10.37 9.99 10.33 9.85 10.27 9.73C10.21 9.61 9.75 8.47 9.56 7.99C9.37 7.53 9.17 7.59 9.03 7.58C8.89 7.58 8.73 7.58 8.57 7.58L8.53 7.33Z"/>
              </svg>
              <span>Mulai Chat WhatsApp Sekarang</span>
            </a>
          </div>

          <!-- Card 2: Lokasi Studio Malang (Interactive Google Maps Embed) -->
          <div class="contact-studio-card">
            <div class="studio-card-header">
              <div class="studio-badge">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Studio Pusat: Kota Malang</span>
              </div>
              <h3>Peta Lokasi Studio & Workshop</h3>
            </div>

            <div class="studio-map-iframe-container">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126438.33878486985!2d112.56174246995646!3d-7.978469493922659!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd62822063dd409%3A0x302730fdac37200!2sKota%20Malang%2C%20Jawa%20Timur!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid"
                width="100%"
                height="210"
                style="border:0; border-radius: 12px; display: block;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Peta Lokasi Studio Bytecture di Kota Malang"
              ></iframe>
            </div>

            <div class="studio-details-grid">
              <div class="studio-detail-item">
                <strong>Alamat Domisili Studio:</strong>
                <p>Kota Malang, Jawa Timur, Indonesia</p>
              </div>
              <div class="studio-detail-item">
                <strong>Cakupan Layanan:</strong>
                <p>{siteConfig.serviceArea} (100% Digital Delivery)</p>
              </div>
              <div class="studio-detail-item">
                <strong>Format Dokumen Final:</strong>
                <p>PDF Master Gambar Kerja A3/A4 &amp; 3D Visual Fotorealistik</p>
              </div>
            </div>

            <a
              href="https://maps.google.com/?q=Kota+Malang,+Jawa+Timur"
              target="_blank"
              rel="noopener noreferrer"
              class="studio-map-link-btn"
            >
              <span>Buka Lokasi di Google Maps</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 7"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: CARD-CARD SOCIAL MEDIA YANG LUMAYAN BESAR
       ========================================================================= -->
  <section class="section-spacing contact-social-section">
    <div class="container">
      <div class="social-section-header">
        <span class="eyebrow eyebrow-accent">JARINGAN KOMUNIKASI &amp; PORTOFOLIO</span>
        <h2>Terhubung di Kanal Media Sosial Resmi Bytecture</h2>
        <p>
          Ikuti keseharian studio arsitek kami, saksikan rilisan visual fasad 3D terbaru, animasi tur video denah, dan tips membangun rumah hemat biaya melalui kanal-kanal di bawah ini.
        </p>
      </div>

      <div class="contact-social-grid">
        {socialCards.map((card) => (
          <div class={`contact-social-card card-${card.type}`}>
            <div class="social-card-top">
              <div class="social-card-icon-wrap" aria-hidden="true">
                {card.type === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.13 15.86C14.15 16.73 14.56 16.56 15 16.51C15.44 16.47 16.42 15.93 16.62 15.36C16.82 14.79 16.82 14.3 16.76 14.2C16.7 14.1 16.54 14.04 16.3 13.92C16.06 13.8 14.88 13.22 14.66 13.14C14.44 13.06 14.28 13.02 14.12 13.26C13.96 13.5 13.5 14.1 13.36 14.26C13.22 14.42 13.08 14.44 12.84 14.32C12.6 14.2 11.83 13.95 10.91 13.13C10.2 12.5 9.71 11.71 9.58 11.47C9.44 11.23 9.56 11.1 9.68 10.98C9.79 10.87 9.93 10.69 10.05 10.55C10.17 10.41 10.21 10.31 10.29 10.15C10.37 9.99 10.33 9.85 10.27 9.73C10.21 9.61 9.75 8.47 9.56 7.99C9.37 7.53 9.17 7.59 9.03 7.58C8.89 7.58 8.73 7.58 8.57 7.58L8.53 7.33Z"/>
                  </svg>
                )}
                {card.type === 'instagram' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5.5" ry="5.5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"></circle>
                  </svg>
                )}
                {card.type === 'tiktok' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.9 2.9 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V8.98a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3 15.28a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V9.05a8.27 8.27 0 0 0 5-1.63l-1.09-2.73z"/>
                  </svg>
                )}
                {card.type === 'facebook' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                )}
                {card.type === 'youtube' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                )}
                {card.type === 'twitter' && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                )}
              </div>
              <span class="social-card-badge">{card.badge}</span>
            </div>

            <div class="social-card-body">
              <h3 class="social-card-name">{card.name}</h3>
              <div class="social-card-handle">{card.handle}</div>
              <p class="social-card-desc">{card.desc}</p>
            </div>

            <a
              href={card.url}
              target="_blank"
              rel="noopener noreferrer"
              class="social-card-btn"
            >
              <span>{card.btnText}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 17 7 7 17 7"></polyline>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQ
    items={generalFaqs}
    title="Pertanyaan yang Sering Diajukan Seputar Kontak & Alur Desain"
    eyebrow="INFORMASI & TRANSPARANSI"
    description="Pelajari alur pengiriman data lahan, durasi asistensi gambar kerja, hingga sistem revisi konsultasi online Bytecture."
    includeSchema={true}
  />
</MainLayout>

<style>
  /* Contact Hero Styles */
  .contact-hero-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .contact-hero-content {
    max-width: 820px;
  }

  .contact-hero-title {
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    font-weight: 700;
  }

  .contact-hero-desc {
    font-size: clamp(1.05rem, 1.8vw, 1.18rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .contact-trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .trust-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    background: #ffffff;
    border: 1px solid rgba(200, 155, 107, 0.35);
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .trust-pill svg {
    color: var(--color-accent-dark);
  }

  .trust-dot-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 6px rgba(22, 163, 74, 0.8);
  }

  /* Main Contact Grid (Form + Sidebar) */
  .contact-main-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 992px) {
    .contact-main-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Form Card */
