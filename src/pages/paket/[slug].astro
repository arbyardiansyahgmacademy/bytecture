---
import MainLayout from '../../layouts/MainLayout.astro';
import { packages, type PackageItem } from '../../data/packages';
import { siteConfig } from '../../data/site';
import CTASection from '../../components/common/CTASection.astro';

export function getStaticPaths() {
  return packages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}

interface Props {
  pkg: PackageItem;
}

const { pkg } = Astro.props;

// Other packages
const otherPackages = packages.filter((p) => p.slug !== pkg.slug);

const pageTitle = `${pkg.title} — Paket Jasa Arsitek`;
const pageDescription = pkg.shortDescription;
const waContextMessage = `Halo Jasa Arsitek, saya tertarik dengan ${pkg.title} (${pkg.priceDisplay}) dan ingin mengetahui estimasi penawaran untuk lahan saya.`;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/paket/${pkg.slug}/`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Paket', url: '/paket/' },
    { name: pkg.title },
  ]}
  ogImage={pkg.image}
>
  <!-- =========================================================================
       HERO SPESIFIK PAKET
       ========================================================================= -->
  <section class="section-spacing" style="padding-top: 1.5rem;">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center;">
        <div style="max-width: 860px;">
          <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem;">
            {pkg.badge && (
              <span class={`badge-pill ${pkg.isRecommended ? 'badge-accent' : 'badge-glass'}`}>
                {pkg.badge}
              </span>
            )}
            <span class="badge-pill badge-glass" style="color: var(--color-text-secondary);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 4px;">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Durasi: {pkg.estimatedDuration}
            </span>
            <span class="badge-pill badge-glass" style="color: var(--color-accent-dark); font-weight: 700;">
              {pkg.revisionPolicy}
            </span>
          </div>

          <h1 style="margin-bottom: 1rem; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.18;">
            {pkg.title}
          </h1>
          
          <div style="margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap;">
            <span style="font-size: clamp(2rem, 4vw, 2.5rem); font-weight: 800; color: var(--color-text-primary); letter-spacing: -0.02em;">
              {pkg.priceDisplay}
            </span>
            <span style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.4;">
              {pkg.priceNote}
            </span>
          </div>

          <p style="font-size: 1.1rem; line-height: 1.75; color: var(--color-text-secondary); margin-bottom: 2rem;">
            {pkg.fullDescription}
          </p>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a
              href={`${siteConfig.whatsappUrl}?text=${encodeURIComponent(waContextMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              style="padding: 0.85rem 1.8rem;"
            >
              <span>Minta Penawaran via WhatsApp</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="/layanan/" target="_self" class="btn btn-secondary" style="padding: 0.85rem 1.6rem;">
              <span>Lihat Detail Layanan</span>
            </a>
          </div>
        </div>

        <div style="border-radius: var(--radius-2xl); overflow: hidden; box-shadow: var(--glass-shadow-lg); border: 1px solid var(--color-border); max-height: 480px;">
          <img
            src={pkg.image}
            alt={`Ilustrasi paket perancangan arsitektur ${pkg.title}`}
            width="800"
            height="500"
            style="width: 100%; height: 100%; object-fit: cover;"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       TARGET KEBUTUHAN (SUITABLE FOR)
       ========================================================================= -->
  <section class="section-spacing" style="background: var(--color-bg-canvas);">
    <div class="container">
      <div style="max-width: 880px; margin: 0 auto; background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(2rem, 5vw, 3rem); box-shadow: var(--glass-shadow-sm);">
        <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.75rem;">TARGET KEBUTUHAN PROYEK</span>
        <h2 style="font-size: clamp(1.4rem, 2.8vw, 1.85rem); margin-bottom: 1.25rem;">
          Paket Ini Sangat Tepat Bagi Anda Yang:
        </h2>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem;">
          {pkg.suitableFor.map((item) => (
            <li style="display: flex; align-items: flex-start; gap: 0.85rem; font-size: 0.98rem; color: var(--color-text-secondary); line-height: 1.6;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-dark)" stroke-width="2.5" style="flex-shrink: 0; margin-top: 3px;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       TERMASUK VS TIDAK TERMASUK (INCLUDED VS NOT INCLUDED)
       ========================================================================= -->
  <section class="section-spacing">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem;">
        <!-- Pekerjaan yang Termasuk -->
        <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--glass-shadow-sm);">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem;">
            <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: #16a34a; color: #ffffff; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h2 style="font-size: 1.35rem; color: var(--color-text-primary); margin: 0;">
              Fasilitas Termasuk (Included):
            </h2>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            Seluruh layanan dan output kerja yang dijamin tercakup dalam biaya paket ini tanpa biaya tersembunyi:
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.9rem;">
            {pkg.included.map((inc) => (
              <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.94rem; color: var(--color-text-primary); line-height: 1.55;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" style="flex-shrink: 0; margin-top: 3px;">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{inc}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Pekerjaan yang Tidak Termasuk -->
        <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--glass-shadow-sm);">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem;">
            <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(20, 21, 23, 0.08); color: var(--color-text-muted); display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </div>
            <h2 style="font-size: 1.35rem; color: var(--color-text-primary); margin: 0;">
              Di Luar Paket (Not Included):
            </h2>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            Ruang lingkup yang tidak termasuk dalam paket ini untuk menjaga efisiensi biaya dasar bagi klien:
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.9rem;">
            {pkg.notIncluded.map((notInc) => (
              <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.92rem; color: var(--color-text-muted); line-height: 1.55;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" style="flex-shrink: 0; margin-top: 3px;">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span>{notInc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       DOKUMEN DELIVERABLES & TAHAPAN PROSES
       ========================================================================= -->
  <section class="section-spacing" style="background: var(--color-bg-canvas);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem;">
        <!-- Berkas Deliverables -->
        <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--glass-shadow-sm);">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem;">
            <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--color-accent-dark); color: #ffffff; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M7 7h10"></path>
                <path d="M7 12h10"></path>
              </svg>
            </div>
            <h2 style="font-size: 1.35rem; color: var(--color-text-primary); margin: 0;">
              Dokumen & File Serah Terima
            </h2>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            Bundel berkas digital resmi yang akan diserahkan kepada Anda setelah proses desain selesai:
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.95rem;">
            {pkg.deliverables.map((deliv) => (
              <li style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.94rem; color: var(--color-text-primary); line-height: 1.55;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.2" style="flex-shrink: 0; margin-top: 3px;">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{deliv}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tahapan Proses Kerja -->
        <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-2xl); padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--glass-shadow-sm);">
          <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem;">
            <div style="width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--color-primary); color: #ffffff; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h2 style="font-size: 1.35rem; color: var(--color-text-primary); margin: 0;">
              Alur Pengerjaan Step-by-Step
            </h2>
          </div>
          <p style="font-size: 0.92rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
            Langkah terarah dari pengisian data lahan hingga penyerahan master dokumen final:
          </p>
          <ol style="list-style: none; display: flex; flex-direction: column; gap: 0.95rem;">
            {pkg.processStages.map((stage, idx) => (
              <li style="display: flex; align-items: flex-start; gap: 0.85rem; font-size: 0.94rem; color: var(--color-text-secondary); line-height: 1.55;">
                <span style="display: inline-flex; width: 26px; height: 26px; border-radius: 50%; background: var(--color-primary); color: #ffffff; font-weight: 700; font-size: 0.78rem; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
                  {idx + 1}
                </span>
                <span>{stage}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SKEMA PEMBAYARAN TERMIN BERTAHAP
       ========================================================================= -->
  <section class="section-spacing">
    <div class="container">
      <div style="background: linear-gradient(135deg, rgba(20, 21, 23, 0.03) 0%, rgba(200, 155, 107, 0.08) 100%); border: 1px solid rgba(200, 155, 107, 0.3); border-radius: var(--radius-2xl); padding: clamp(2rem, 5vw, 3rem); box-shadow: var(--glass-shadow-sm);">
        <div style="max-width: 820px; margin-bottom: 2rem;">
          <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.5rem;">TRANSPARANSI KEUANGAN</span>
          <h2 style="font-size: clamp(1.6rem, 3.2vw, 2.1rem); margin-bottom: 0.75rem;">
            Skema Pembayaran Termin Aman & Bertahap
          </h2>
          <p style="font-size: 1rem; color: var(--color-text-secondary); line-height: 1.65;">
            Kami menjamin rasa aman bagi klien dengan menerapkan sistem termin bertahap. Pembayaran dilakukan secara berjenjang setelah setiap milestone pengerjaan selesai dan disetujui.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
          {pkg.paymentStages.map((stage, idx) => (
            <div style="background: #ffffff; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; box-shadow: 0 4px 14px rgba(0,0,0,0.03);">
              <span style="font-size: 0.8rem; font-weight: 800; color: var(--color-accent-dark); text-transform: uppercase; letter-spacing: 0.08em;">
                Termin {idx + 1}
              </span>
              <p style="font-size: 0.94rem; color: var(--color-text-primary); line-height: 1.55; margin: 0; font-weight: 500;">
                {stage}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       PILIHAN PAKET LAINNYA
       ========================================================================= -->
  <section class="section-spacing" style="background: var(--color-bg-canvas);">
    <div class="container">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.5rem;">OPSI LAIN</span>
          <h2 style="font-size: 1.6rem; margin: 0;">Pilihan Paket Lainnya</h2>
        </div>
        <a href="/paket/" target="_self" class="btn btn-secondary" style="font-size: 0.86rem; padding: 0.55rem 1.2rem;">
          <span>Bandingkan Semua Paket</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>

      <div class="cards-grid-3">
        {otherPackages.slice(0, 3).map((p) => (
          <div style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--glass-shadow-sm);">
            <div>
              <span class="badge-pill" style="font-size: 0.72rem; padding: 0.2rem 0.6rem; margin-bottom: 0.75rem;">{p.badge}</span>
              <h3 style="font-size: 1.25rem; margin-bottom: 0.4rem;">{p.title}</h3>
              <div style="font-size: 1.15rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.75rem;">
                {p.priceDisplay}
              </div>
              <p style="font-size: 0.88rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
                {p.shortDescription}
              </p>
            </div>
            <a href={`/paket/${p.slug}/`} target="_self" class="btn btn-secondary" style="width: 100%;">
              <span>Pelajari {p.title}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       CTA SECTION
       ========================================================================= -->
  <CTASection
    title={`Mulai Konsultasi ${pkg.title}`}
    description="Sampaikan rencana proyek Anda kepada tim tim Jasa Arsitek untuk memperoleh estimasi waktu dan simulasi penawaran resmi."
    customMessage={waContextMessage}
  />
</MainLayout>
