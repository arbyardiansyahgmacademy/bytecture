---
import type { TestimonialItem } from '../../data/testimonials';

interface Props {
  testimonial: TestimonialItem;
}

const { testimonial } = Astro.props;
const initials = testimonial.name.slice(0, 2).toUpperCase();
---

<div class="testimonial-card">
  <div class="stars-row" aria-label={`Rating ${testimonial.rating} dari 5 bintang`}>
    {Array.from({ length: testimonial.rating }).map(() => (
      <svg viewBox="0 0 24 24">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
    ))}
  </div>

  <blockquote class="testimonial-quote">
    "{testimonial.quote}"
  </blockquote>

  <div class="testimonial-author">
    <div class="author-avatar">{initials}</div>
    <div class="author-info">
      <span class="author-name">{testimonial.name}</span>
      <span class="author-meta">{testimonial.projectType} &bull; {testimonial.location}</span>
    </div>
  </div>
</div>

