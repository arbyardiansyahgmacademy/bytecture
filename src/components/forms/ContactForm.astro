---
import { siteConfig } from '../../data/site';
---

<div class="contact-form-card">
  <form id="jasa-arsitek-contact-form" novalidate>
    <div class="form-grid">
      <div class="form-grid form-grid-2">
        <!-- Nama -->
        <div class="form-group">
          <label for="contact-name" class="form-label">Nama Lengkap <span style="color: #ef4444;">*</span></label>
          <input
            type="text"
            id="contact-name"
            name="name"
            class="form-input"
            placeholder="Contoh: Budi Pratama"
            required
            autocomplete="name"
          />
          <span class="form-error" id="name-error" style="display: none; color: #ef4444; font-size: 0.8rem;">Mohon isi nama lengkap Anda.</span>
        </div>

        <!-- WhatsApp -->
        <div class="form-group">
          <label for="contact-whatsapp" class="form-label">Nomor WhatsApp Aktif <span style="color: #ef4444;">*</span></label>
          <input
            type="tel"
            id="contact-whatsapp"
            name="whatsapp"
            class="form-input"
            placeholder="Contoh: 08123456789"
            required
            autocomplete="tel"
          />
          <span class="form-error" id="whatsapp-error" style="display: none; color: #ef4444; font-size: 0.8rem;">Mohon isi nomor WhatsApp yang valid.</span>
        </div>
      </div>

      <div class="form-grid form-grid-2">
        <!-- Kota / Provinsi -->
        <div class="form-group">
          <label for="contact-location" class="form-label">Kota / Lokasi Proyek <span style="color: #ef4444;">*</span></label>
          <input
            type="text"
            id="contact-location"
            name="location"
            class="form-input"
            placeholder="Contoh: Surabaya, Jawa Timur"
            required
          />
          <span class="form-error" id="location-error" style="display: none; color: #ef4444; font-size: 0.8rem;">Mohon sebutkan lokasi kota atau daerah proyek.</span>
        </div>

        <!-- Jenis Layanan -->
        <div class="form-group">
          <label for="contact-service" class="form-label">Jenis Kebutuhan Desain <span style="color: #ef4444;">*</span></label>
          <select id="contact-service" name="service" class="form-select" required>
            <option value="">-- Pilih Jenis Proyek --</option>
            <option value="Desain Rumah Tinggal Baru">Desain Rumah Tinggal Baru</option>
            <option value="Desain Bangunan Komersial / Ruko / Kafe">Desain Bangunan Komersial / Ruko / Kafe</option>
            <option value="Desain Villa / Hospitality">Desain Villa / Hospitality</option>
            <option value="Desain Interior Ruangan">Desain Interior Ruangan</option>
            <option value="Renovasi & Perluasan Bangunan">Renovasi & Perluasan Bangunan</option>
            <option value="Konsultasi Konsep Awal">Konsultasi Konsep Awal</option>
          </select>
          <span class="form-error" id="service-error" style="display: none; color: #ef4444; font-size: 0.8rem;">Pilih jenis kebutuhan proyek Anda.</span>
        </div>
      </div>

      <!-- Detail Pesan -->
      <div class="form-group">
        <label for="contact-message" class="form-label">Rincian Kebutuhan & Luas Lahan <span style="color: #ef4444;">*</span></label>
        <textarea
          id="contact-message"
          name="message"
          class="form-textarea"
          placeholder="Jelaskan perkiraan ukuran tanah (contoh: 10x15m), jumlah kamar tidur, rencana lantai, atau referensi gaya desain yang diinginkan..."
          required
        ></textarea>
        <span class="form-error" id="message-error" style="display: none; color: #ef4444; font-size: 0.8rem;">Mohon berikan sedikit rincian mengenai kebutuhan ruang Anda.</span>
      </div>

      <!-- Persetujuan Checkbox -->
      <div class="form-group">
        <label class="form-checkbox-label">
          <input type="checkbox" id="contact-agree" name="agree" required />
          <span>Saya bersedia dihubungi oleh tim Jasa Arsitek via WhatsApp untuk konsultasi dan estimasi penawaran desain.</span>
        </label>
        <span class="form-error" id="agree-error" style="display: none; color: #ef4444; font-size: 0.8rem;">Anda perlu menyetujui opsi ini untuk melanjutkan.</span>
      </div>

      <!-- Keterangan Transparansi WhatsApp -->
      <p class="form-note">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-right: 4px;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        Data yang Anda masukkan tidak disimpan di database server kami. Menekan tombol di bawah akan membuka aplikasi WhatsApp resmi Jasa Arsitek (<strong>{siteConfig.phoneDisplay}</strong>) dengan teks yang telah tersusun otomatis.
      </p>

      <button type="submit" class="btn btn-whatsapp" style="width: 100%; padding: 0.95rem; font-size: 1.05rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.13 15.86C14.15 16.73 14.56 16.56 15 16.51C15.44 16.47 16.42 15.93 16.62 15.36C16.82 14.79 16.82 14.3 16.76 14.2C16.7 14.1 16.54 14.04 16.3 13.92C16.06 13.8 14.88 13.22 14.66 13.14C14.44 13.06 14.28 13.02 14.12 13.26C13.96 13.5 13.5 14.1 13.36 14.26C13.22 14.42 13.08 14.44 12.84 14.32C12.6 14.2 11.83 13.95 10.91 13.13C10.2 12.5 9.71 11.71 9.58 11.47C9.44 11.23 9.56 11.1 9.68 10.98C9.79 10.87 9.93 10.69 10.05 10.55C10.17 10.41 10.21 10.31 10.29 10.15C10.37 9.99 10.33 9.85 10.27 9.73C10.21 9.61 9.75 8.47 9.56 7.99C9.37 7.53 9.17 7.59 9.03 7.58C8.89 7.58 8.73 7.58 8.57 7.58L8.53 7.33Z"/>
        </svg>
        <span>Lanjutkan Konsultasi ke WhatsApp</span>
      </button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('jasa-arsitek-contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const waInput = document.getElementById('contact-whatsapp') as HTMLInputElement;
    const locInput = document.getElementById('contact-location') as HTMLInputElement;
    const serviceSelect = document.getElementById('contact-service') as HTMLSelectElement;
    const msgInput = document.getElementById('contact-message') as HTMLTextAreaElement;
    const agreeCheck = document.getElementById('contact-agree') as HTMLInputElement;

    let isValid = true;

    // Helper validate
    const checkField = (input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, errorId: string, condition: boolean) => {
      const err = document.getElementById(errorId);
      if (!condition) {
        if (err) err.style.display = 'block';
        input.style.borderColor = '#ef4444';
        isValid = false;
      } else {
        if (err) err.style.display = 'none';
        input.style.borderColor = '';
      }
    };

    checkField(nameInput, 'name-error', nameInput.value.trim().length >= 2);
    checkField(waInput, 'whatsapp-error', waInput.value.trim().length >= 8);
    checkField(locInput, 'location-error', locInput.value.trim().length >= 2);
    checkField(serviceSelect, 'service-error', serviceSelect.value !== '');
    checkField(msgInput, 'message-error', msgInput.value.trim().length >= 5);
    checkField(agreeCheck, 'agree-error', agreeCheck.checked);

    if (!isValid) return;

    // Format WhatsApp message
    const formattedText = 
`*KONSULTASI DESAIN ARSITEKTUR — JASA ARSITEK*
---------------------------------------
*Nama:* ${nameInput.value.trim()}
*No. WhatsApp:* ${waInput.value.trim()}
*Kota/Lokasi Proyek:* ${locInput.value.trim()}
*Jenis Kebutuhan:* ${serviceSelect.value}

*Rincian Kebutuhan:*
${msgInput.value.trim()}

---------------------------------------
_Dikirim melalui formulir kontak resmi jasaarsitek.biz.id_`;

    const waUrl = `https://wa.me/6283115542771?text=${encodeURIComponent(formattedText)}`;
    window.open(waUrl, '_blank');
  });
</script>

