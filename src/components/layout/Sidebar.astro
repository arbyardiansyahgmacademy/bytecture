---
import { siteConfig } from '../../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Active state helper
const isActive = (path: string) => {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
};

const navItems = [
  {
    name: 'Beranda',
    path: '/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 21v-7a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v7"/><circle cx="12" cy="7.5" r="0.8" fill="currentColor"/></svg>`,
  },
  {
    name: 'Tentang Kami',
    path: '/tentang-kami/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.2"/><path d="m10.5 7.2-5.5 13.8"/><path d="m13.5 7.2 5.5 13.8"/><path d="M8 15h8"/><circle cx="12" cy="15" r="0.75" fill="currentColor"/></svg>`,
  },
  {
    name: 'Layanan',
    path: '/layanan/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9h18"/><path d="M9 21V9"/><path d="m14 14 3 3"/></svg>`,
  },
  {
    name: 'Paket',
    path: '/paket/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 4.5-9 4.5-9-4.5z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/></svg>`,
  },
  {
    name: 'Galeri',
    path: '/galeri/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2.5"/><path d="m3 15 5-5a2 2 0 0 1 2.8 0l7.2 7.2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m14 14 2-2a2 2 0 0 1 2.8 0L21 14.2"/></svg>`,
  },
  {
    name: 'Blog',
    path: '/blog/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M8 7h8"/><path d="M8 11h6"/><path d="M8 15h4"/></svg>`,
  },
  {
    name: 'Kontak',
    path: '/kontak/',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/><circle cx="9" cy="12" r="1" fill="currentColor"/><circle cx="12" cy="12" r="1" fill="currentColor"/><circle cx="15" cy="12" r="1" fill="currentColor"/></svg>`,
  },
];
---

<aside class="desktop-sidebar" aria-label="Navigasi Utama Bytecture">
  <div class="sidebar-glass-inner">
    <!-- Brand / Logo -->
    <a href="/" class="sidebar-brand" title="Bytecture — Beranda">
      <div class="brand-logo-wrap">
        <img
          src="/images/logo/logo-bytecture.webp"
          alt="Logo Resmi Bytecture"
          width="44"
          height="44"
          class="brand-logo-img"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="brand-info">
        <span class="brand-name">Bytecture</span>
        <span class="brand-badge">Jasa Arsitek Online</span>
      </div>
    </a>

    <!-- Navigation List -->
    <nav class="sidebar-nav">
      {navItems.map((item) => (
        <a
          href={item.path}
          class={`nav-link ${isActive(item.path) ? 'active' : ''}`}
          aria-current={isActive(item.path) ? 'page' : undefined}
        >
          <Fragment set:html={item.icon} />
          <span>{item.name}</span>
        </a>
      ))}
    </nav>

    <!-- Sidebar CTA -->
    <div class="sidebar-footer">
      <a
        href={siteConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="sidebar-cta-btn"
        aria-label="Konsultasi WhatsApp Arsitek Bytecture"
      >
        <span>Konsultasi WA</span>
        <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="7" y1="17" x2="17" y2="7"/>
          <polyline points="7 7 17 7 17 17"/>
        </svg>
      </a>
    </div>
  </div>
</aside>

