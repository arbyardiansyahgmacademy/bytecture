---
import { siteConfig } from '../../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const allNavItems = [
  { name: 'Beranda', path: '/' },
  { name: 'Tentang Kami', path: '/tentang-kami/' },
  { name: 'Layanan', path: '/layanan/' },
  { name: 'Paket', path: '/paket/' },
  { name: 'Galeri', path: '/galeri/' },
  { name: 'Blog Edukasi', path: '/blog/' },
  { name: 'Kontak', path: '/kontak/' },
];

const isActive = (path: string) => {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
};
---

<header class="mobile-header">
  <a href="/" target="_self" class="mobile-brand" title="Jasa Arsitek — Beranda">
    <div class="brand-logo-wrap mobile">
      <img
        src="/images/logo/logo-bytecture.webp"
        alt="Logo Resmi Jasa Arsitek"
        width="36"
        height="36"
        class="brand-logo-img"
        loading="eager"
        decoding="async"
      />
    </div>
    <span class="brand-name">Jasa Arsitek</span>
  </a>

  <div class="mobile-header-actions">
    <button
      id="mobile-drawer-btn"
      class="mobile-menu-toggle"
      aria-label="Buka Menu Navigasi Lengkap Jasa Arsitek"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="16" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Drawer Modal -->
<div id="mobile-drawer" class="mobile-drawer-overlay" aria-hidden="true">
  <div class="mobile-drawer-panel" role="dialog" aria-modal="true" aria-label="Menu Lengkap Jasa Arsitek">
    <div class="drawer-header">
      <div class="mobile-brand">
        <div class="brand-logo-wrap mobile">
          <img
            src="/images/logo/logo-bytecture.webp"
            alt="Logo Resmi Jasa Arsitek"
            width="36"
            height="36"
            class="brand-logo-img"
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="brand-name">Jasa Arsitek</span>
      </div>
      <button id="mobile-drawer-close" class="drawer-close" aria-label="Tutup Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="drawer-nav">
      {allNavItems.map((item) => (
        <a
          href={item.path}
          target="_self"
          class={`drawer-link ${isActive(item.path) ? 'active' : ''}`}
        >
          {item.name}
        </a>
      ))}
    </nav>

    <div style="margin-top: auto; padding-top: 1.5rem; border-top: 1px solid var(--color-border-light);">
      <p style="font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">Konsultasi Online Indonesia</p>
      <a
        href={siteConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
        style="width: 100%; font-size: 0.88rem;"
      >
        Chat WhatsApp Arsitek
      </a>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('mobile-drawer-btn');
  const closeBtn = document.getElementById('mobile-drawer-close');
  const drawer = document.getElementById('mobile-drawer');

  function openDrawer() {
    drawer?.classList.add('open');
    drawer?.setAttribute('aria-hidden', 'false');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closeDrawer();
    }
  });
</script>

