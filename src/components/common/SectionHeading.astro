---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  centered?: boolean;
}

const { eyebrow, title, description, centered = false } = Astro.props;
---

<div class={`section-heading ${centered ? 'text-center' : ''}`} style={`max-width: 720px; ${centered ? 'margin: 0 auto 3rem;' : 'margin-bottom: 2.5rem;'}`}>
  {eyebrow && <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.75rem;">{eyebrow}</span>}
  <h2 style="margin-bottom: 0.85rem;">{title}</h2>
  {description && <p style="font-size: 1.05rem; line-height: 1.65; color: var(--color-text-secondary);">{description}</p>}
</div>

<style>
  .text-center {
    text-align: center;
  }
</style>

