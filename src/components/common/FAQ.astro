---
import { siteConfig } from '../../data/site';

export interface FAQItem {
  id?: string;
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
  eyebrow?: string;
  description?: string;
  includeSchema?: boolean;
}

const {
  items,
  title = 'Pertanyaan yang Sering Diajukan (FAQ)',
  eyebrow = 'INFORMASI & TRANSPARANSI',
  description = 'Temukan jawaban lengkap seputar alur kerja konsultasi arsitektur online, jangkauan wilayah, dan deliverables proyek bersama tim Jasa Arsitek.',
  includeSchema = false,
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="section-spacing">
  <div class="container">
    <div style="max-width: 720px; margin: 0 auto 3rem; text-align: center;">
      {eyebrow && <span class="eyebrow eyebrow-accent" style="margin-bottom: 0.75rem; justify-content: center;">{eyebrow}</span>}
      <h2 style="margin-bottom: 0.85rem;">{title}</h2>
      {description && <p style="font-size: 1.05rem; line-height: 1.65; color: var(--color-text-secondary);">{description}</p>}
    </div>

    <div class="faq-list">
      {items.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-trigger">
            <div class="faq-q-left">
              <span class="faq-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="faq-title-text">{item.question}</span>
            </div>
            <div class="faq-toggle-circle" aria-hidden="true">
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </summary>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              <p class="faq-answer-text">{item.answer}</p>
              <div class="faq-answer-footer">
                <span class="faq-verified-pill">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                  <span>Jawaban Resmi Tim Jasa Arsitek</span>
                </span>
                <a
                  href={siteConfig.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="faq-consult-link"
                >
                  <span>Konsultasikan Proyek Anda</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 7"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>

  {includeSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</section>

