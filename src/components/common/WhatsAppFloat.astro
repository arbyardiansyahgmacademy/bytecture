---
import { siteConfig } from '../../data/site';

interface Props {
  customMessage?: string;
}

const { customMessage = 'Halo Jasa Arsitek, saya ingin berkonsultasi mengenai kebutuhan desain arsitektur.' } = Astro.props;
const whatsappLink = `${siteConfig.whatsappUrl}?text=${encodeURIComponent(customMessage)}`;
